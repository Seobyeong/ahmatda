# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
credentials.json

# Metro
.metro-health-check*

# Android native build
android/app/build/
android/build/
android/.gradle/
android/local.properties

# iOS native build
ios/Pods/
ios/build/
ios/DerivedData/
*.xcuserstate
xcuserdata/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
!.env.example

# typescript
*.tsbuildinfo

# Claude Code local-only settings (machine-specific permission overrides)
.claude/settings.local.json

# 과제 강의 교재 (저작물, 원본은 Downloads에 보관)
docs/과제/*.pdf

# 로컬 Expo 모듈 빌드 산출물
modules/*/android/build/

# 문서·과제 자료는 로컬에만 둔다 (GitHub에 올리지 않음)
docs/
# 앱 실행에 필요 없는 파일은 로컬에만 둔다
.claude/
AGENTS.md
CLAUDE.md
R.I.D Process.png
legal/
scripts/
LICENSE
*.jpg
*.zip
