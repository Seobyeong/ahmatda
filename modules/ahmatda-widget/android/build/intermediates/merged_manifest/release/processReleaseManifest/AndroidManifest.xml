<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="expo.modules.ahmatdawidget" >

    <uses-sdk android:minSdkVersion="24" />

    <application>

        <!--
         홈 화면 출발 위젯. APPWIDGET_UPDATE는 시스템(런처)이 보내는 브로드캐스트라
         exported=true여야 받을 수 있다.
        -->
        <receiver
            android:name="expo.modules.ahmatdawidget.DepartureWidgetProvider"
            android:exported="true"
            android:label="@string/ahmatda_widget_label" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ahmatda_departure_widget_info" />
        </receiver>
    </application>

</manifest>