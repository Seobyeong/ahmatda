<?xml version="1.0" encoding="utf-8"?>
<!-- 업데이트는 앱이 체크리스트가 바뀔 때마다 직접 밀어준다. updatePeriodMillis는
     날짜가 바뀐 뒤 "앱을 열어 확인" 문구로 넘어가기 위한 안전망 (시스템 최소값 30분).
     새로 놓으면 2칸 높이 — 물건 줄(최대 3개)까지 보인다. 1칸으로 줄이면 위쪽 줄만. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:minWidth="180dp"
  android:minHeight="40dp"
  android:targetCellWidth="3"
  android:targetCellHeight="2"
  android:resizeMode="horizontal|vertical"
  android:updatePeriodMillis="1800000"
  android:initialLayout="@layout/ahmatda_departure_widget"
  android:description="@string/ahmatda_widget_description"
  android:widgetCategory="home_screen" />
